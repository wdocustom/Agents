# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
SERPER_API_KEY=your_serper_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Social Media Credentials (Reddit)
# Get these at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# Your Business Information
BUSINESS_NAME=Your Construction Company
BUSINESS_PHONE=(402) 555-1234
BUSINESS_EMAIL=info@yourcompany.com
BUSINESS_WEBSITE=https://yourcompany.com
SERVICES=tile work, bathroom remodeling, kitchen renovation, flooring

# Target Location Settings
TARGET_CITY=Omaha
TARGET_STATE=NE
TARGET_RADIUS_MILES=35
TARGET_LAT=41.2565
TARGET_LON=-95.9345

# Lead Generation Settings
MAX_LEADS_PER_RUN=25
MIN_LEAD_SCORE=60
OUTPUT_DIRECTORY=./output

# Search Settings
SEARCH_DEPTH=moderate  # Options: quick, moderate, thorough
CONCURRENT_SEARCHES=3

# Database (Optional)
DATABASE_URL=sqlite:///./leads.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/lead_generation.log

# Engagement Settings
AUTO_ENGAGE=false  # Set to true to enable automatic commenting (WARNING: read docs first!)
ENGAGEMENT_DELAY_MIN=30  # Minimum minutes between engagements
ENGAGEMENT_DAILY_LIMIT=10  # Maximum engagements per day
