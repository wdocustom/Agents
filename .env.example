# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
SERPER_API_KEY=your_serper_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Target Location Settings
TARGET_CITY=Omaha
TARGET_STATE=NE
TARGET_RADIUS_MILES=35
TARGET_LAT=41.2565
TARGET_LON=-95.9345

# Lead Generation Settings
MAX_LEADS_PER_RUN=25
MIN_LEAD_SCORE=60
OUTPUT_DIRECTORY=./output

# Search Settings
SEARCH_DEPTH=moderate  # Options: quick, moderate, thorough
CONCURRENT_SEARCHES=3

# Database (Optional)
DATABASE_URL=sqlite:///./leads.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/lead_generation.log
